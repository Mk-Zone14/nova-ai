# Copy to .env.local for local development (npm run dev). Never commit real values.

# Required: Groq API key used by /api/analyze
GROQ_API_KEY=

# Optional: override the model (default: openai/gpt-oss-120b)
# GROQ_MODEL=

# Optional but recommended in production: shared rate limiting across serverless
# instances (Upstash Redis REST). If unset, a per-instance in-memory limiter is used,
# which does NOT protect your Groq quota on Vercel (a warning is logged once).
# Forwarding headers are trusted only when running on Vercel; elsewhere the socket address is used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
