# Copy to .env.local for local development (npm run dev). Never commit real values.

# Required: Groq API key used by /api/analyze
GROQ_API_KEY=

# Optional: override the model (default: openai/gpt-oss-120b)
# GROQ_MODEL=

# Optional: shared rate limiting across serverless instances (Upstash Redis REST).
# Currently deferred and not configured: production runs on the per-instance in-memory
# limiter by design, and no Upstash setup is required. If unset, that limiter is used and
# a one-time warning is logged. The code path stays supported should this be enabled later.
# Forwarding headers are trusted only when running on Vercel; elsewhere the socket address is used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
